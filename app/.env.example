# Copy to .env (gitignored). EXPO_PUBLIC_* values are bundled into the app, so only public values go here.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Clerk publishable key (public by design), see backend/config/clerk.dev.public.env
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Local development only: sign in by pasting a simulated token from `vv_backend.devtools token`.
# Ignored in production builds; the backend refuses simulated tokens when VV_ENV=prod.
EXPO_PUBLIC_DEV_AUTH=
