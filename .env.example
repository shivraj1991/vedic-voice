# Copy to .env and fill in values. Never commit .env.

# --- Neon Postgres ---
# Pooled connection string (serverless runtime). Must include sslmode=require.
DATABASE_URL=
# Direct (non-pooled) connection string for Alembic migrations only.
DATABASE_URL_MIGRATIONS=
# Neon *test branch* connection string used by integration tests (never main).
DATABASE_URL_TEST=

# --- Clerk ---
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=
# App (Expo) — publishable key only; secret key never ships in the app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_BUCKET_REFERENCE=
R2_BUCKET_RECORDINGS=
# Read-only key (signed GET URLs)
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
# Write key scoped to upload prefixes (signed PUT URLs)
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=

# --- AWS (scoring service invocation) ---
AWS_REGION=
SCORING_FUNCTION_NAME=

# --- Claude API (offline content pipeline only) ---
ANTHROPIC_API_KEY=
