# Clerk DEVELOPMENT instance - public values only (no secrets in this file).
# The secret key (sk_...) never goes in the repo; the backend does not need it.
CLERK_ISSUER=https://exciting-man-4331.clerk.accounts.dev
CLERK_JWKS_URL=https://exciting-man-4331.clerk.accounts.dev/.well-known/jwks.json
# azp values: Expo web dev server / admin console origins (add production origins later)
CLERK_AUTHORIZED_PARTIES=http://localhost:8081,http://localhost:19006
# Native iOS/Android requests have no Origin, so Clerk omits azp on their tokens.
CLERK_ALLOW_MISSING_AZP=true
# For the Expo app (Milestone 3); publishable keys are public by design.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhjaXRpbmctbWFuLTQzMzEuY2xlcmsuYWNjb3VudHMuZGV2JA
